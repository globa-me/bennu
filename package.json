{
  "name": "bennu",
  "version": "1.0.0",
  "description": "A lightweight live HTML document editor.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --environment jsdom --exclude \"**/e2e/**\"",
    "test:e2e": "playwright test",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name bennu"
  },
  "keywords": [
    "html",
    "editor",
    "vite",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  }
}
